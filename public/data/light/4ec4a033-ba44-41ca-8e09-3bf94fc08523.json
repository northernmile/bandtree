 },
 "lede": "Swirlies came together in Cambridge in 1990: two guitarists in odd tunings, a pile of effects pedals, and tapes and AM radio static filling the gaps. Damon Tutunjian has kept the band going ever since.",
 "hero": {
  "src": "https://upload.wikimedia.org/wikipedia/commons/2/2b/Swirlies_in_1992.jpg",
  "by": "Photo: Morganfitzp / Wikimedia Commons (CC BY-SA 4.0), MIT practice space, 1992"
 },
 "facts": [
  {
   "h": "It started as a plan for a Go-Go's cover band",
   "p": "Fanzine publisher Rusty Nails brought Seana Carmody and Damon Tutunjian together in spring 1990 to cover the Go-Go's. They learned two songs, switched to originals, and put one track, as Raspberry Bang, on an animal-rights benefit 7-inch.",
   "src": {
    "title": "Swirlies (Taang! Records)",
    "url": "https://www.taang.com/swirlies"
   }
  },
  {
   "h": "Andy Bernick played AM radio static while the guitarists retuned",
   "p": "Carmody and Tutunjian played in alternate tunings, so between songs the bassist filled the gaps with tapes or static from an old AM radio.",
   "src": {
    "title": "Swirlies (Taang! Records)",
    "url": "https://www.taang.com/swirlies"
   }
  },
  {
   "h": "Trouser Press filed them under Boston's \"chimp rock\"",
   "p": "That informal Boston/Cambridge scene also took in Kudgel and Fat Day. The guide hears My Bloody Valentine, home-taping weirdness and pop in the records, with mellotron, Moog, shortwave radio and feedback in the mix.",
   "src": {
    "title": "Swirlies (Trouser Press)",
    "url": "http://www.trouserpress.com/entry.php?a=swirlies"
   }
  }
 ],
